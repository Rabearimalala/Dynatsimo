# ==============================================================================
# DYNATSIMO — MODÈLE DE FICHIER D'AUTHENTIFICATION (.env.example)
# ==============================================================================
# Copiez ce fichier sous le nom '.env' pour définir vos identifiants réels.
# ==============================================================================

# GOOGLE EARTH ENGINE
EE_PROJECT=eehanitriniala
EE_ACCOUNT=hanitriniala

# GEOSERVER
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver
GEOSERVER_WORKSPACE=dynatsimo
GEOSERVER_NAMESPACE=http://dynatsimo

# POSTGRESQL / POSTGIS
DYNATSIMO_DBHOST=localhost
DYNATSIMO_DBPORT=5432
DYNATSIMO_DBNAME=precipitation
DYNATSIMO_DBUSER=postgres
DYNATSIMO_DBPASSWORD=admin
DYNATSIMO_COMMUNES_TABLE=public.communes
DYNATSIMO_GEOM_COLUMN=geom

# API & AUTO SYNC
DYNATSIMO_API_HOST=127.0.0.1
DYNATSIMO_API_PORT=8000
DYNATSIMO_AUTO_SYNC=true
DYNATSIMO_SYNC_INTERVAL_HOURS=12
DYNATSIMO_CORS_ORIGIN=*

# SOURCE DE DONNÉES
CHIRPS_BASE_URL=https://data.chc.ucsb.edu/products/CHIRPS-2.0/global_monthly/tifs
